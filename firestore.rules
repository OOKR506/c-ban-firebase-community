rules_version = '2';

/*
  C반 놈들 - Firestore 보안 규칙

  설계 원칙
  - 기본은 전부 거부하고, 앱이 실제로 쓰는 경로만 허용합니다.
  - 게시글·댓글·투표·공지는 비로그인 방문자도 읽을 수 있습니다 (포트폴리오 데모 열람용).
  - 회원 정보(users)는 이메일이 들어 있어 로그인한 사용자만 읽을 수 있습니다.
  - 관리자 권한(isAdmin)은 사용자가 스스로 바꿀 수 없습니다. 관리자는 콘솔에서 직접 지정합니다.
  - 작성·수정·삭제는 본인 또는 관리자만 가능합니다.

  알려진 한계
  - 포인트 계산(출석·룰렛·게임·상점)이 브라우저 코드에서 이뤄져서, 규칙만으로는
    사용자가 자기 포인트를 임의로 올리는 것을 완전히 막을 수 없습니다.
    (서버 측 검증이 필요하면 Cloud Functions로 옮겨야 합니다.)
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // 수정 시 바뀌는 필드 목록
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 숫자 필드가 delta 범위 안에서만 변했는지
    function deltaWithin(field, minDelta, maxDelta) {
      return (request.resource.data.get(field, 0) - resource.data.get(field, 0)) >= minDelta
        && (request.resource.data.get(field, 0) - resource.data.get(field, 0)) <= maxDelta;
    }

    // ---------- 회원 ----------
    match /users/{uid} {
      allow read: if signedIn();

      // 가입: 본인 문서만, 관리자·차단 아님, 시작 포인트 100
      allow create: if isOwner(uid)
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('isBanned', false) == false
        && request.resource.data.points == 100;

      allow update: if
        // 본인: 관리자·차단 여부는 바꿀 수 없고, 포인트는 음수가 될 수 없음
        (isOwner(uid)
          && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
          && request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)
          && request.resource.data.get('points', 0) >= 0)
        // 다른 로그인 사용자: 팔로워 수만 ±1 변경 가능
        || (signedIn()
          && changedKeys().hasOnly(['followerCount'])
          && deltaWithin('followerCount', -1, 1))
        || isAdmin();

      allow delete: if isOwner(uid) || isAdmin();
    }

    // 개인 데이터 (미션, 업적, 북마크, 구매 내역)
    match /userData/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isOwner(uid) || isAdmin();
    }

    // 출석 기록: 문서 ID = 날짜_uid
    match /attendance/{attendanceId} {
      allow read: if signedIn()
        && (attendanceId.matches('.*_' + request.auth.uid)
          || resource.data.userId == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && attendanceId.matches('.*_' + request.auth.uid)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 일일 룰렛: 문서 ID = 날짜_uid (하루 1회)
    match /roulette/{spinId} {
      allow read: if signedIn()
        && (spinId.matches('.*_' + request.auth.uid)
          || resource.data.userId == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && spinId.matches('.*_' + request.auth.uid)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 게임 기록
    match /gameHistory/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- 게시글 / 댓글 ----------
    match /posts/{postId} {
      allow read: if true;

      allow create: if (signedIn() && request.resource.data.authorId == request.auth.uid)
        || isAdmin();

      allow update: if
        // 작성자: 작성자 ID는 바꿀 수 없음
        (signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId)
        || isAdmin()
        // 조회수: 누구나 +1만 가능
        || (changedKeys().hasOnly(['views'])
          && deltaWithin('views', 1, 1))
        // 좋아요·댓글 수: 로그인 사용자
        || (signedIn()
          && changedKeys().hasOnly(['likes', 'likedBy', 'likeCount', 'commentCount'])
          && request.resource.data.get('commentCount', 0) >= 0
          && request.resource.data.get('likeCount', 0) >= 0);

      // 삭제는 관리자만 (일반 삭제는 isDeleted 플래그로 처리됨)
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;

        allow update: if
          (signedIn()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId)
          || isAdmin()
          // 댓글 좋아요
          || (signedIn()
            && changedKeys().hasOnly(['likes', 'likeCount']));

        allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
      }
    }

    // ---------- 공지 / 사이트 설정 ----------
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 투표 ----------
    match /polls/{pollId} {
      allow read: if true;

      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;

      allow update: if
        (signedIn() && resource.data.authorId == request.auth.uid)
        || isAdmin()
        // 투표 참여: 선택지 득표와 총 투표 수만 변경
        || (signedIn() && changedKeys().hasOnly(['options', 'totalVotes']));

      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // ---------- D-Day ----------
    match /ddays/{ddayId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // ---------- 채팅 ----------
    match /chatRooms/{roomId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      // 본인 메시지 삭제(isDeleted 처리) 또는 관리자
      allow update: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /chatRoomsMeta/{roomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /chatMutes/{muteId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 접속 상태: 본인 문서만 기록
    match /userPresence/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // ---------- 쪽지 ----------
    match /directMessages/{dmId} {
      allow read: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromId == request.auth.uid;
      // 받는 사람은 읽음 처리만 가능
      allow update: if signedIn()
        && resource.data.toId == request.auth.uid
        && changedKeys().hasOnly(['isRead']);
      allow delete: if signedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    // ---------- 알림 ----------
    match /notifications/{notifId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // 다른 사용자에게 알림을 보낼 수 있지만, 보낸 사람 표시는 본인이어야 함
      allow create: if signedIn()
        && (request.resource.data.get('fromId', null) == null
          || request.resource.data.fromId == request.auth.uid);
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- 팔로우: 문서 ID = 팔로워uid_대상uid ----------
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
    }

    // ---------- 신고 / 관리자 기록 ----------
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /pointLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 위에 정의되지 않은 경로는 모두 거부됩니다.
  }
}
